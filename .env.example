# ConnectHub Microservices - Docker Environment Variables
# Copy this file to .env and fill in the required values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
MYSQL_PASSWORD=secure_root_password_here

# ============================================================================
# ADMIN & SECURITY
# ============================================================================
ADMIN_PASSWORD=secure_admin_password_here
JWT_SECRET=your-secure-jwt-secret-key-here-min-32-chars-required

# ============================================================================
# MAIL CONFIGURATION (Email Notifications)
# ============================================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password-here

# ============================================================================
# OAUTH2 PROVIDERS (Social Login)
# ============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ============================================================================
# FRONTEND & GATEWAY URLS
# ============================================================================
FRONTEND_URL=http://localhost:4200
FRONTEND_ALLOWED_ORIGIN_PATTERNS=http://localhost:4200,https://connect-hub-frontend-one.vercel.app,https://connect-hub-frontend-git-*-mohit-d360s-projects.vercel.app
GATEWAY_URL=http://localhost:8080

# ============================================================================
# AWS S3 CONFIGURATION (Media Storage)
# ============================================================================
AWS_S3_BUCKET=connecthub-media-b
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ============================================================================
# TWILIO CONFIGURATION (SMS Notifications)
# ============================================================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# ============================================================================
# FIREBASE CONFIGURATION (Push Notifications)
# ============================================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY=your-firebase-private-key

# ============================================================================
# RAZORPAY CONFIGURATION (Payment Gateway)
# ============================================================================
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
